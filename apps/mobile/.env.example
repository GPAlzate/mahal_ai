# Origin of the deployed Next.js app that serves the API routes.
# For local dev against the web app, use your machine's LAN IP or the ngrok URL
# (the `pnpm dev` script in the web app starts ngrok), e.g. https://abc123.ngrok-free.app
EXPO_PUBLIC_API_URL=https://your-deployed-app.vercel.app

# Clerk publishable key — MUST be the same Clerk instance as the web app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
