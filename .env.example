# Neon Database Connection
DATABASE_URL=postgresql://user:password@ep-xxx.pooler.neon.tech/dbname

# OpenAI API Key
OPENAI_API_KEY=sk-proj-...

# Vercel Blob Storage Token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Vercel Blob public base URL (e.g. https://<store-id>.public.blob.vercel-storage.com)
BLOB_BASE_URL=https://<store-id>.public.blob.vercel-storage.com

# Clerk Auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...


# Your Clerk user ID — gates admin/early-access features
NEXT_PUBLIC_ADMIN_USER_ID=user_...

# Web Push (VAPID) — generate with: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:you@example.com
# Shared secret protecting /api/cron/* endpoints
CRON_SECRET=...
